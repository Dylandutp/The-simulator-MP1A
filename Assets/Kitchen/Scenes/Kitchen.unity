TextMesh:
  serializedVersion: 3
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 839744295}
  m_Text: "01   ROAST CHICKEN\n       Pale -15  /  Golden +30  /  Burnt -20\n      
    Close oven. Set 25-30 seconds.\n\n02   PAN-SEARED STEAK\n       Rare +5  /  Perfect
    +25  /  Burnt -15\n       Medium heat: 8-17 seconds.\n\n03   FRUIT & VEG SALAD\n      
    Clean +20  /  Dirty -15\n       Wash 3s, chop two kinds, mix."
  m_OffsetZ: 0
  m_CharacterSize: 0.022
  m_LineSpacing: 1
